{
  "name": "anvil",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A workspace whose tools are written at runtime, by your agent, with your approval.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:sandbox": "node scripts/run-sandbox-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test": "npm run test:sandbox && npm run test:fallback && npm run test:e2e",
    "shots": "node scripts/shot.mjs",
    "test:fallback": "node scripts/run-sandbox-tests.mjs \"http://localhost:5173/sandbox-tests.html?isolation=simulate-blocked\"",
    "measure": "node scripts/measure-variance.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
