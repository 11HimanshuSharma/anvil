{
  "name": "anvil",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "A workspace whose tools are written at runtime, by your agent, with your approval.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
