    "test:e2e": "node scripts/run-e2e.mjs",
    "test": "node scripts/run-sandbox-tests.mjs && node scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
